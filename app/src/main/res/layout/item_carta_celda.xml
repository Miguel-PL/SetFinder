<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/carta_celda_fondo"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/carta_celda_borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="96dp"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/text_numero_carta"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/fondo_badge_numero"
            android:gravity="center"
            android:textColor="@color/celda_numero_texto"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="7" />

        <ImageView
            android:id="@+id/image_carta_celda"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/miniatura_carta"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:ignore="ImageContrastCheck" />

        <TextView
            android:id="@+id/text_resumen_carta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/celda_sumario_texto"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            tools:text="2 Verde&#10;Rombo&#10;Rayado" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
