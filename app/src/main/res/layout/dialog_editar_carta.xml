<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/LabelDialog"
        android:text="@string/label_numero" />

    <Spinner
        android:id="@+id/dialog_spinner_numero"
        style="@style/SpinnerTouchTarget48" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/LabelDialog"
        android:layout_marginTop="8dp"
        android:text="@string/label_color" />

    <Spinner
        android:id="@+id/dialog_spinner_color"
        style="@style/SpinnerTouchTarget48" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/LabelDialog"
        android:layout_marginTop="8dp"
        android:text="@string/label_forma" />

    <Spinner
        android:id="@+id/dialog_spinner_forma"
        style="@style/SpinnerTouchTarget48" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/LabelDialog"
        android:layout_marginTop="8dp"
        android:text="@string/label_relleno" />

    <Spinner
        android:id="@+id/dialog_spinner_relleno"
        style="@style/SpinnerTouchTarget48" />

</LinearLayout>
