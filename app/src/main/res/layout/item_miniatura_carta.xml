<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    app:cardBackgroundColor="@color/carta_celda_fondo"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/carta_celda_borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/text_numero_miniatura"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/fondo_badge_numero"
            android:gravity="center"
            android:textColor="@color/celda_numero_texto"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="1" />

        <ImageView
            android:id="@+id/image_miniatura"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/miniatura_carta"
            android:scaleType="fitCenter"
            tools:ignore="ImageContrastCheck" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
